<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>leap_teleop_bridge</name>
  <version>0.1.0</version>
  <description>Robot-specific bridges from the teleop target to a robot controller.</description>
  <maintainer email="130978844+jr-hartono@users.noreply.github.com">jr-hartono</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>leap_teleop_core</depend>
  <depend>leap_teleop_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- MoveIt Servo is a peer process reached over a topic, not a link dependency. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
