<?xml version="1.0"?>
<!-- Semantic description of the demo robot. The name must match robot.urdf.xacro. -->
<robot name="ur5e_2f85">
  <!-- The chain ends at the TCP, so Servo's Jacobian refers to it. -->
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="gripper_tcp"/>
  </group>

  <!-- Arm pairs, from ur_moveit_config. -->
  <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="tool0" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>

  <!-- The gripper is rigid on wrist_3_link, and its links touch each other by design. -->
  <disable_collisions link1="wrist_3_link" link2="ur_to_robotiq_link" reason="Gripper"/>
  <disable_collisions link1="wrist_3_link" link2="robotiq_85_base_link" reason="Gripper"/>
  <disable_collisions link1="wrist_3_link" link2="robotiq_85_left_knuckle_link" reason="Gripper"/>
  <disable_collisions link1="wrist_3_link" link2="robotiq_85_left_finger_link" reason="Gripper"/>
  <disable_collisions link1="wrist_3_link" link2="robotiq_85_left_inner_knuckle_link" reason="Gripper"/>
  <disable_collisions link1="wrist_3_link" link2="robotiq_85_left_finger_tip_link" reason="Gripper"/>
  <disable_collisions link1="wrist_3_link" link2="robotiq_85_right_knuckle_link" reason="Gripper"/>
  <disable_collisions link1="wrist_3_link" link2="robotiq_85_right_finger_link" reason="Gripper"/>
  <disable_collisions link1="wrist_3_link" link2="robotiq_85_right_inner_knuckle_link" reason="Gripper"/>
  <disable_collisions link1="wrist_3_link" link2="robotiq_85_right_finger_tip_link" reason="Gripper"/>
  <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_base_link" reason="Gripper"/>
  <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_left_knuckle_link" reason="Gripper"/>
